---
/** SilkCover signature: an eight-pointed girih star {8/3} around an octagon. */
import { starPath, polygonPath } from '../lib/geometry';
interface Props { class?: string; title?: string; draw?: boolean }
const { class: cls = '', title, draw = false } = Astro.props;
const star = starPath(8, 3, 46, 0, 0, -67.5);
const core = polygonPath(8, 12, 0, 0, -67.5);
---
<svg class:list={['mark', cls, { 'mark--draw': draw }]} viewBox="-50 -50 100 100" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <path class="mark-star" d={star} pathLength="1" />
  <path class="mark-core" d={core} pathLength="1" />
</svg>
<style>
  .mark { fill: none; stroke: currentColor; stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; overflow: visible; }
  .mark-core { stroke-width: 2.4; }
  .mark--draw path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: mark-draw 1.1s var(--ease-arch) forwards; }
  .mark--draw .mark-core { animation-delay: 0.55s; animation-duration: 0.6s; }
  @keyframes mark-draw { to { stroke-dashoffset: 0; } }
</style>
