---
/** SilkCover emblem (the ribbon "S" in a diamond), from the client's logo. */
interface Props { class?: string; title?: string; draw?: boolean; eager?: boolean }
const { class: cls = '', title, draw = false, eager = false } = Astro.props;
---
<span class:list={['mark', cls, { 'mark--draw': draw }]} role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <picture>
    <source srcset="/brand/emblem.webp" type="image/webp" />
    <img src="/brand/emblem.png" width="293" height="256" alt="" loading={eager || draw ? 'eager' : 'lazy'} decoding="async" />
  </picture>
</span>
<style>
  .mark { display: inline-grid; place-items: center; line-height: 0; }
  .mark picture { display: contents; }
  .mark img { width: 100%; height: 100%; object-fit: contain; }
  .mark--draw img { animation: mark-in 1.3s var(--ease-arch) both; }
  @keyframes mark-in {
    from { opacity: 0; transform: scale(0.82) rotate(-12deg); clip-path: inset(50% 50% 50% 50%); }
    60% { opacity: 1; }
    to { opacity: 1; transform: none; clip-path: inset(-10% -10% -10% -10%); }
  }
  @media (prefers-reduced-motion: reduce) { .mark--draw img { animation: none; } }
</style>
