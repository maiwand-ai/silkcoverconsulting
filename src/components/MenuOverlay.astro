---
/**
 * Menu hub: a colonnade of arch doorways, one per page shown in the menu.
 * One doorway is open at a time and shows that page's sections beside its arch.
 * On desktop, pointing at a doorway opens it; on touch screens a toggle does.
 * Doorways, labels and order all come from the admin (Pages → Menu).
 */
import { archPolygon } from '../lib/geometry';
import { menuSectionsFor, type Site, type Page } from '../lib/content';
import GirihTile from './GirihTile.astro';
import Mark from './Mark.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { site: Site; page?: Page; alternates: { locale: string; href: string; name: string }[] }
const { site, page, alternates } = Astro.props;
const S = site.settings;
const clipClosed = archPolygon(50, 100, 0.01, 0);
const clipOpen = archPolygon(50, 100, 150, 95);
const onHome = page?.slug === 'home';
const doors = site.nav.filter((p) => p.slug !== 'home');
const expertise = site.byTemplate('expertise');
// Open by default: the page you are on, otherwise Our Expertise, otherwise the first doorway.
const defaultOpen = doors.some((d) => d.slug === page?.slug) ? page!.slug : expertise && doors.includes(expertise) ? expertise.slug : doors[0]?.slug;
---
<div id="site-menu" class="menu" data-menu aria-hidden="true" inert role="dialog" aria-modal="true" aria-label={S.header.menu}
  style={`--clip-closed:${clipClosed};--clip-open:${clipOpen}`}>
  <div class="menu__backdrop" data-menu-backdrop aria-hidden="true"></div>
  <div class="menu__panel" data-menu-panel>
  <div class="menu__inner container">

    <div class="menu__top">
      <a class="menu__brand" href={site.pagePath('home')} aria-current={onHome ? 'page' : undefined}>
        <Mark class="menu__mark" />
        <span lang="en" dir="ltr">SilkCover</span>
        <span class="menu__home">{onHome ? S.menu.onHome : S.menu.backHome}</span>
      </a>
      <div class="menu__top-actions">
        <LangSwitch class="menu__lang" alternates={alternates} current={site.locale} label={S.menu.language} />
        <button class="menu__close" type="button" data-menu-close>{S.menu.close} <span aria-hidden="true">×</span></button>
      </div>
    </div>

    <div class="menu__intro">
      <p class="menu__kicker">{S.menu.kicker}</p>
    </div>

    <nav class="menu__doors" aria-label={S.header.menu}>
      <ul>
        {doors.map((item, i) => {
          const isCurrent = item.slug === page?.slug;
          const isOpen = item.slug === defaultOpen;
          const sections = menuSectionsFor(item, site);
          const listId = `door-list-${i}`;
          const href = site.pagePath(item.slug);
          const label = item.menu.label || item.title;
          return (
            <li class:list={['door', { 'door--open': isOpen, 'door--current': isCurrent }]} style={`--i:${i}`} data-door={href} data-default={isOpen ? '' : undefined}>
              <a class="door__link" href={href} aria-current={isCurrent ? 'page' : undefined}>
                <span class="door__art">
                  <GirihTile id={`door-${i}`} fold={Number(item.menu.fold)} tone={item.menu.tone} tile={item.template.discriminant === 'expertise' ? 80 : 96} h={600} />
                  {isCurrent && <span class="door__badge door__badge--here">{S.menu.youAreHere}</span>}
                </span>
                <span class="door__text">
                  <span class="door__title">{label}</span>
                  <span class="door__blurb">{item.menu.blurb}</span>
                  <span class="door__go" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
                  </span>
                </span>
              </a>
              {sections.length > 0 && (
                <>
                  <button type="button" class="door__toggle" aria-expanded={isOpen ? 'true' : 'false'} aria-controls={listId} data-door-toggle>
                    <span class="visually-hidden">{S.menu.sectionsOf} {label}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </button>
                  <ul class="door__sections" id={listId} aria-label={`${S.menu.sectionsOf} ${label}`}>
                    {sections.map((sec) => (
                      <li><a href={`${href}#${sec.id}`}><span>{sec.label}</span><i aria-hidden="true"></i></a></li>
                    ))}
                  </ul>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="menu__base">
      <p class="menu__line">{S.tagline.join(' ')}</p>
      <p class="menu__contact">
        <span class="menu__contact-label">{S.menu.enquiries}</span>
        <span dir="ltr">{site.global.email}</span>
        {site.global.emailPlaceholder && <span class="sample-tag">{S.tags.placeholder}</span>}
      </p>
      <LangSwitch class="menu__lang-bottom" alternates={alternates} current={site.locale} label={S.menu.language} />
      <button class="btn btn--solid" type="button" data-enquire data-menu-close>{S.menu.enquire}</button>
    </div>
  </div>
  <span class="menu__edge" aria-hidden="true"><i></i></span>
  </div>
</div>

<style>
  /* Wrapper: holds the dimmed page backdrop and the panel */
  .menu { position: fixed; inset: 0; z-index: 80; color: var(--ivory); visibility: hidden; pointer-events: none; transition: visibility 0s 0.95s; }
  :global(.menu-open) .menu { visibility: visible; pointer-events: auto; transition: visibility 0s; }
  .menu__backdrop { position: absolute; inset: 0; background: rgba(10, 19, 32, 0.5); backdrop-filter: blur(5px) saturate(0.9); -webkit-backdrop-filter: blur(5px) saturate(0.9); opacity: 0; transition: opacity 0.5s var(--ease-out); }
  :global(.menu-open) .menu__backdrop { opacity: 1; }
  .menu__panel {
    position: relative; max-height: 100%; overflow-y: auto; overscroll-behavior: contain;
    background: radial-gradient(80% 90% at 50% 120%, var(--lapis-700) 0%, var(--lapis-900) 55%, var(--lapis-950) 100%);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
  }
  /* Desktop: the hub drops down over the current page, which stays visible beneath */
  @media (min-width: 1181px) {
    .menu__panel { overflow: visible; max-height: none; transform: translateY(-101%); transition: transform 0.8s var(--ease-arch); }
    .menu__panel .menu__inner { max-height: calc(100dvh - 16px); overflow-y: auto; overscroll-behavior: contain; }
    :global(.menu-open) .menu__panel { transform: none; }
  }
  /* Tablets and phones: full screen, opening through the arch */
  @media (max-width: 1180px) {
    .menu__backdrop { display: none; }
    .menu__panel { height: 100%; clip-path: var(--clip-closed); transition: clip-path 0.95s var(--ease-arch); }
    :global(.menu-open) .menu__panel { clip-path: var(--clip-open); }
  }
  /* Brass edge with a centre diamond along the bottom of the dropped panel */
  .menu__edge { position: absolute; inset-inline-start: 0; inset-inline-end: 0; bottom: 0; display: block; height: 1px; background: linear-gradient(90deg, transparent, var(--brass) 20%, var(--brass) 80%, transparent); }
  .menu__edge i { position: absolute; left: 50%; top: -5px; width: 11px; height: 11px; transform: translateX(-50%) rotate(45deg); background: var(--lapis-900); border: 1px solid var(--brass); }
  @media (max-width: 1180px) { .menu__edge { display: none; } }
  .menu__inner { min-height: 100%; display: grid; grid-template-rows: auto auto 1fr auto; gap: clamp(16px, 2.4vh, 28px);
    padding-top: calc(env(safe-area-inset-top, 0px) + 18px); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 24px); }

  /* Top bar */
  .menu__top { display: flex; justify-content: space-between; align-items: center; min-height: 42px; }
  .menu__brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--font-display); font-size: 1.3rem; letter-spacing: 0.06em; }
  .menu__brand :global(.menu__mark) { width: 32px; height: 32px; color: var(--brass); transition: transform 0.9s var(--ease-arch); }
  .menu__brand:hover :global(.menu__mark) { transform: rotate(45deg); }
  .menu__home { font-family: var(--font-body); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(242, 236, 223, 0.55); margin-inline-start: 10px; padding-inline-start: 14px; border-inline-start: 1px solid var(--line-dark); transition: color 0.2s; }
  .menu__brand:hover .menu__home { color: var(--turquoise); }
  .menu__top-actions { display: flex; align-items: center; gap: 12px; }
  .menu__base :global(.menu__lang-bottom) { display: none; }
  @media (max-width: 560px) { .menu__top-actions :global(.menu__lang) { display: none; } .menu__base :global(.menu__lang-bottom) { display: inline-flex; } }
  .menu__close { background: none; color: inherit; border: 1px solid rgba(242, 236, 223, 0.4); border-radius: 999px; min-height: 42px; padding: 0 18px; cursor: pointer; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; display: inline-flex; gap: 10px; align-items: center; transition: border-color 0.2s, color 0.2s; }
  .menu__close:hover { border-color: var(--turquoise); color: var(--turquoise); }
  .menu__close span { font-size: 1.3rem; line-height: 1; letter-spacing: 0; }

  .menu__kicker { font-family: var(--font-display); font-size: clamp(1.6rem, 1rem + 2vw, 2.6rem); line-height: 1.1; opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease-out), transform 0.8s var(--ease-out); }
  :global(.menu-open) .menu__kicker { opacity: 1; transform: none; transition-delay: 0.3s; }

  /* Colonnade */
  .menu__doors { align-self: center; }
  .menu__doors > ul { list-style: none; display: flex; gap: clamp(14px, 1.6vw, 26px); align-items: flex-start; }
  .door {
    flex: 1 1 0; min-width: 0; display: grid; align-content: start; align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0fr); column-gap: 0;
    transition: flex-grow 0.65s var(--ease-arch), grid-template-columns 0.65s var(--ease-arch), column-gap 0.65s var(--ease-arch), opacity 0.5s var(--ease-out);
  }
  .door--open { flex-grow: 2.5; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); column-gap: clamp(14px, 1.6vw, 26px); }
  .door__toggle { display: none; }
  :global(.menu-open) .door { animation: door-in 0.95s var(--ease-arch) backwards; animation-delay: calc(0.36s + var(--i) * 0.07s); }
  @keyframes door-in { from { opacity: 0; transform: translateY(48px); } }
  .door__link { display: grid; gap: 14px; text-decoration: none; color: inherit; position: relative; }
  .door__art { position: relative; display: block; width: min(100%, 22vh); aspect-ratio: 1 / 2; transition: transform 0.7s var(--ease-arch), filter 0.5s; }
  .door__art::after { content: ''; position: absolute; inset: 20% -10% -6%; z-index: -1; background: radial-gradient(closest-side, rgba(79, 189, 177, 0.45), transparent); opacity: 0; transition: opacity 0.6s; }
  .door__art :global(svg) { width: 100%; height: 100%; }
  .door__art :global(.girih-tile__pattern) { transition: transform 1.6s var(--ease-out); }
  .door__text { display: grid; gap: 6px; position: relative; padding-inline-end: 28px; }
  .door__title { font-family: var(--font-display); font-size: clamp(1.15rem, 0.8rem + 0.9vw, 1.6rem); line-height: 1.15; transition: color 0.3s; }
  .door--open .door__title { font-size: clamp(1.3rem, 0.9rem + 1.1vw, 1.9rem); }
  .door__blurb { font-size: 0.86rem; line-height: 1.45; color: rgba(242, 236, 223, 0.62); }
  .door__go { position: absolute; inset-inline-end: 0; top: 0.2em; width: 22px; height: 22px; }
  .door__go svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform 0.4s var(--ease-out); }
  .door__badge { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); white-space: nowrap; font-size: 0.64rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 9px; border-radius: 2px; background: rgba(10, 19, 32, 0.82); color: var(--brass); border: 1px solid rgba(176, 141, 87, 0.5); }
  .door__badge--here { background: var(--turquoise); color: var(--lapis-900); border-color: var(--turquoise); }

  /* Hover and focus: the doorway you point at lifts and lights; others step back */
  @media (hover: hover) {
    .menu__doors > ul:hover .door:not(:hover) { opacity: 0.5; }
  }
  a.door__link:hover .door__art, a.door__link:focus-visible .door__art { transform: translateY(-12px); }
  a.door__link:hover .door__art::after, a.door__link:focus-visible .door__art::after { opacity: 1; }
  a.door__link:hover :global(.girih-tile__pattern), a.door__link:focus-visible :global(.girih-tile__pattern) { transform: rotate(22.5deg) scale(1.12); }
  a.door__link:hover .door__title, a.door__link:focus-visible .door__title { color: var(--turquoise); }
  a.door__link:hover .door__go svg { transform: translateX(5px); }
  a.door__link:focus-visible { outline: none; }
  a.door__link:focus-visible .door__title { text-decoration: underline; text-underline-offset: 6px; }

  /* Section list beside the open doorway */
  .door__sections {
    list-style: none; display: grid; align-self: start; min-width: 0; overflow: hidden;
    margin-top: clamp(16px, 6vh, 72px); border-top: 1px solid var(--line-dark); padding-bottom: 2px;
    opacity: 0; visibility: hidden; transform: translateX(-12px); max-height: 0;
    transition: opacity 0.2s, transform 0.2s, visibility 0s 0.2s;
  }
  .door--open .door__sections { max-height: 80vh; }
  .door--open .door__sections { opacity: 1; visibility: visible; transform: none; transition: opacity 0.45s var(--ease-out) 0.3s, transform 0.55s var(--ease-out) 0.3s, visibility 0s; }
  .door__sections a { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 2px; border-bottom: 1px solid var(--line-dark); text-decoration: none; font-size: 0.84rem; line-height: 1.3; color: rgba(242, 236, 223, 0.82); transition: color 0.2s, padding 0.4s var(--ease-out); }
  .door__sections a i { width: 7px; height: 7px; border: 1px solid var(--brass); transform: rotate(45deg); flex: none; transition: background 0.3s, border-color 0.3s; }
  .door__sections a:hover, .door__sections a:focus-visible { color: var(--turquoise); padding-inline-start: 8px; }
  .door__sections a:hover i, .door__sections a:focus-visible i { background: var(--turquoise); border-color: var(--turquoise); }

  /* Base bar */
  .menu__base { display: grid; grid-template-columns: 1fr auto auto; gap: 16px 32px; align-items: center; padding-top: 18px; border-top: 1px solid var(--line-dark); opacity: 0; transition: opacity 0.7s; }
  :global(.menu-open) .menu__base { opacity: 1; transition-delay: 0.7s; }
  .menu__line { font-family: var(--font-display); font-size: 1.05rem; color: rgba(242, 236, 223, 0.7); }
  .menu__contact { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 0.9rem; }
  .menu__contact-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass); }

  /* Phones and tablets: doorways become rows with arch thumbnails */
  @media (max-width: 1180px) {
    .menu__inner { grid-template-rows: auto auto auto auto; align-content: start; }
    .menu__doors { align-self: start; }
    .menu__doors > ul { grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--line-dark); }
    .menu__doors > ul { display: grid; }
    .door, .door--open { grid-template-columns: minmax(0, 1fr) auto; column-gap: 8px; border-bottom: 1px solid var(--line-dark); transition: opacity 0.5s; }
    .door__toggle { display: grid; place-items: center; align-self: center; width: 44px; height: 44px; border-radius: 50%; background: none; border: 1px solid var(--line-dark); color: inherit; cursor: pointer; }
    .door__toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; transition: transform 0.4s var(--ease-arch); }
    .door--open .door__toggle { border-color: var(--turquoise); color: var(--turquoise); }
    .door--open .door__toggle svg { transform: rotate(180deg); }
    .door__go { display: none; }
    .door__sections { grid-column: 1 / -1; display: none; transform: none; }
    .door--open .door__sections { display: grid; }
    .door__link { grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 16px; padding: 14px 0; }
    .door__art { width: 44px; }
    .door__badge { display: none; }
    .door__text { padding-inline-end: 30px; }
    .door__go { top: 50%; transform: translateY(-50%); }
    .door--current .door__title::after { content: 'You are here'; display: inline-block; margin-inline-start: 10px; vertical-align: middle; font-family: var(--font-body); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lapis-900); background: var(--turquoise); padding: 2px 6px; border-radius: 2px; }
    .door__sections { grid-template-columns: 1fr 1fr; column-gap: 16px; border-top: 0; margin: -4px 0 14px 60px; }
    .door__sections a { font-size: 0.82rem; padding: 8px 0; }
    .menu__base { grid-template-columns: 1fr; justify-items: start; }
    .menu__home { display: none; }
  }
  @media (min-width: 700px) and (max-width: 1180px) {
    .door__link { grid-template-columns: 60px minmax(0, 1fr); padding: 18px 0; }
    .door__art { width: 60px; }
    .door__sections { grid-template-columns: repeat(3, 1fr); margin-inline-start: 76px; }
  }
  @media (max-width: 480px) { .door__sections { grid-template-columns: 1fr; margin-inline-start: 0; } }
  @media (min-width: 1181px) {
    .menu__inner { min-height: 0; padding-bottom: 28px; }
    .menu__kicker { font-size: clamp(1.4rem, 0.9rem + 1.4vw, 2.1rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__panel, :global(.menu-open) .menu__panel { transition: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const panel = menu?.querySelector<HTMLElement>('[data-menu-panel]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  // Hover-to-open only where there is a real pointer and the drop-down layout.
  const hoverable = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1181px)');
  let lastFocus: HTMLElement | null = null;
  let mode: 'hover' | 'click' | null = null;
  let openTimer = 0, closeTimer = 0;
  let openedAt = 0;

  const focusables = () =>
    Array.from(menu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? []);

  function open(how: 'hover' | 'click') {
    if (!menu || !panel) return;
    clearTimeout(closeTimer);
    if (mode === 'click' || mode === how) return;
    const wasOpen = mode !== null;
    mode = how;
    if (!wasOpen) {
      openedAt = performance.now();
      lastFocus = document.activeElement as HTMLElement;
      root.classList.add('menu-open');
      menu.removeAttribute('inert');
      menu.setAttribute('aria-hidden', 'false');
      panel.scrollTop = 0;
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    }
    if (how === 'click') {
      // Opened deliberately: lock the page and move focus into the menu.
      document.body.style.overflow = 'hidden';
      const target = menu.querySelector<HTMLElement>('[data-default] .door__link') ?? focusables()[0];
      setTimeout(() => target?.focus({ preventScroll: true }), 300);
    }
  }
  function close(restore = true) {
    clearTimeout(openTimer); clearTimeout(closeTimer);
    if (!menu || mode === null) return;
    const wasClick = mode === 'click';
    mode = null;
    root.classList.remove('menu-open');
    menu.setAttribute('inert', '');
    menu.setAttribute('aria-hidden', 'true');
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    document.body.style.overflow = '';
    setTimeout(resetDoors, 600);
    if (restore && wasClick) lastFocus?.focus({ preventScroll: true });
  }
  // One open doorway at a time.
  const doors = Array.from(menu?.querySelectorAll<HTMLElement>('[data-door]') ?? []);
  const setDoor = (door: HTMLElement | undefined) => {
    doors.forEach((d) => {
      const on = d === door;
      d.classList.toggle('door--open', on);
      d.querySelector('[data-door-toggle]')?.setAttribute('aria-expanded', String(on));
    });
  };
  const resetDoors = () => setDoor(doors.find((d) => d.hasAttribute('data-default')));
  const desktop = matchMedia('(min-width: 1181px)');
  doors.forEach((d) => {
    // Only react to real pointer movement after the panel has finished dropping in,
    // so doorways sliding past a resting cursor do not open by accident.
    d.addEventListener('pointermove', (e) => {
      if (desktop.matches && e.pointerType === 'mouse' && performance.now() - openedAt > 900 && !d.classList.contains('door--open')) setDoor(d);
    });
    d.addEventListener('focusin', () => { if (desktop.matches) setDoor(d); });
    d.querySelector('[data-door-toggle]')?.addEventListener('click', () => setDoor(d.classList.contains('door--open') ? undefined : d));
  });

  const scheduleClose = () => {
    clearTimeout(openTimer);
    if (mode !== 'hover') return;
    clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => close(false), 280);
  };

  openers.forEach((b) => {
    b.addEventListener('click', () => open('click'));
    b.addEventListener('mouseenter', () => {
      if (!hoverable.matches) return;
      clearTimeout(closeTimer);
      openTimer = window.setTimeout(() => open('hover'), 110);
    });
    b.addEventListener('mouseleave', () => { clearTimeout(openTimer); scheduleClose(); });
  });
  panel?.addEventListener('mouseenter', () => clearTimeout(closeTimer));
  panel?.addEventListener('mouseleave', scheduleClose);
  // Clicking inside a hover-opened panel makes it stay open like a clicked one.
  panel?.addEventListener('pointerdown', () => { if (mode === 'hover') mode = 'click'; });
  menu?.querySelector('[data-menu-backdrop]')?.addEventListener('click', () => close());

  menu?.querySelectorAll('[data-menu-close]').forEach((b) => b.addEventListener('click', () => close(!(b as HTMLElement).hasAttribute('data-enquire'))));
  // Same-page links (e.g. a service on the Expertise page) should close the menu.
  menu?.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => a.addEventListener('click', () => {
    const url = new URL(a.href, location.href);
    if (url.pathname === location.pathname) close(false);
  }));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mode) close();
    if (e.key === 'Tab' && mode === 'click') {
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>
