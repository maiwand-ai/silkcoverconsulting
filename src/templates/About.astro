---
import GirihTile from '../components/GirihTile.astro';
import IdentityFigure from '../components/IdentityFigure.astro';
import Closing from '../components/Closing.astro';
import SectionRail from '../components/SectionRail.astro';
import { starPath } from '../lib/geometry';
import { emph, sectionsFor, type Site, type Page } from '../lib/content';

interface Props { site: Site; page: Page }
const { site, page } = Astro.props;
if (page.template.discriminant !== 'about') throw new Error('About template needs an about page');
const v = page.template.value;
const S = site.settings;
const keys = ['global', 'cultural', 'strategic'];
const expertisePath = site.templatePath('expertise');
---
<!-- OPENING -->
<section class="a-open" data-tone="ivory" aria-labelledby="a-title">
  <div class="container a-open__grid">
    <div class="a-open__text">
      <p class="eyebrow">{v.hero.eyebrow}</p>
      <h1 id="a-title" set:html={emph(v.hero.title)} />
      <p class="lede muted">{site.withCount(v.hero.lede, true)}</p>
    </div>
    <figure class="a-open__art">
      <GirihTile id="about-hero" fold={8} tone="turquoise" tile={92} h={560} label={v.hero.caption} />
      <figcaption>{v.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<SectionRail items={sectionsFor(page, site)} title={S.common.onThisPage} />

<!-- WHO WE ARE -->
<section class="section a-intro" id="overview" data-tone="light" aria-labelledby="a-intro-h">
  <div class="container a-intro__grid">
    <h2 id="a-intro-h" data-reveal>{v.intro.title}</h2>
    <div class="a-intro__cols" data-reveal style="--delay:.1s">
      {v.intro.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <ul class="a-intro__services" aria-label={S.footer.expertise} data-reveal style="--delay:.15s">
      {site.services.map((s) => <li><a href={`${expertisePath}#${s.slug}`}>{s.label}</a></li>)}
    </ul>
  </div>
</section>

<!-- PRINCIPLES -->
<section class="a-story" id="principles" data-tone="dark" aria-labelledby="a-story-h" data-story>
  <div class="container a-story__grid">
    <div class="a-story__sticky">
      <p class="eyebrow">{v.principles.section.eyebrow}</p>
      <h2 id="a-story-h">{v.principles.section.title}</h2>
      <div class="a-story__fig"><IdentityFigure tone="dark" /></div>
      <ol class="a-story__dots" aria-hidden="true">
        {v.principles.items.slice(0, 3).map((_, i) => <li data-dot={keys[i]}></li>)}
      </ol>
    </div>
    <div class="a-story__steps">
      {v.principles.items.slice(0, 3).map((s, i) => (
        <article class="a-story__step" data-step={keys[i]}>
          <p class="a-story__num">{(i + 1).toLocaleString(site.info.lang, { minimumIntegerDigits: 2 })} / {(3).toLocaleString(site.info.lang, { minimumIntegerDigits: 2 })}</p>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </article>
      ))}
      {v.principles.draft && <p class="a-story__note"><span class="sample-tag">{S.tags.draft}</span></p>}
    </div>
  </div>
</section>

<!-- VALUES -->
<section class="section a-values" id="values" data-tone="light" aria-labelledby="a-values-h">
  <div class="container">
    <header class="a-head">
      <p class="eyebrow" data-reveal>{v.values.section.eyebrow}</p>
      <h2 id="a-values-h" data-reveal>{v.values.section.title}</h2>
      {v.values.draft && <span class="sample-tag" data-reveal>{S.tags.draft}</span>}
    </header>
    <ul class="a-values__list" style={`--n:${Math.max(1, Math.min(5, v.values.items.length))}`}>
      {v.values.items.map((val, i) => (
        <li class="a-value" data-reveal style={`--delay:${i * 0.06}s`}>
          <svg viewBox="-50 -50 100 100" aria-hidden="true"><path d={starPath(8, 3, 44)} /></svg>
          <h3>{val.title}</h3>
          <p class="muted">{val.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- LEADERSHIP -->
{v.team.people.length > 0 && (
<section class="section a-team" id="leadership" data-tone="ivory" aria-labelledby="a-team-h">
  <div class="container">
    <header class="a-head">
      <p class="eyebrow" data-reveal>{v.team.section.eyebrow}</p>
      <h2 id="a-team-h" data-reveal>{v.team.section.title}</h2>
      {v.team.people.some((p) => p.sample) && <span class="sample-tag" data-reveal>{S.tags.sample}</span>}
    </header>
    <ul class="a-team__grid">
      {v.team.people.map((t, i) => (
        <li class="person" data-reveal style={`--delay:${i * 0.08}s`}>
          <div class="person__art"><GirihTile id={`team-${i}`} fold={Number(t.fold)} tone={i % 3 === 1 ? 'turquoise' : 'dark'} tile={74} h={460} label={t.name} /></div>
          <p class:list={['person__name', { 'is-sample': t.sample }]}>{t.name}</p>
          <h3>{t.role}</h3>
          <p class="muted">{t.focus}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

<!-- IDENTITY -->
<section class="section a-heritage" id="identity" data-tone="light" aria-labelledby="a-her-h">
  <div class="container a-heritage__grid">
    <div class="a-heritage__art" data-reveal>
      <GirihTile id="heritage" fold={10} tone="dark" arch={false} tile={120} h={300} />
    </div>
    <div class="a-heritage__text">
      <p class="eyebrow" data-reveal>{v.identity.section.eyebrow}</p>
      <h2 id="a-her-h" data-reveal>{v.identity.section.title}</h2>
      {v.identity.paragraphs.map((p, i) => <p class="muted" data-reveal style={`--delay:${0.06 + i * 0.04}s`}>{p}</p>)}
    </div>
  </div>
</section>

<Closing heading={v.closing.title} text={v.closing.text} button={S.common.makeEnquiry} />
<style>
  /* Opening */
  .a-open { padding-top: calc(var(--header-h) + clamp(40px, 7vw, 100px)); padding-bottom: clamp(56px, 8vw, 110px); overflow: hidden; }
  .a-open__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .a-open__text { display: grid; gap: 26px; }
  .a-open h1 { font-size: clamp(2.6rem, 1.4rem + 5vw, 6.4rem); line-height: 1; letter-spacing: -0.01em; }
  .a-open h1 :global(em) { font-style: normal; color: var(--turquoise-ink); }
  .a-open .lede { max-width: 44ch; }
  .a-open__art { margin: 0; display: grid; gap: 10px; justify-items: end; animation: rise 1.2s var(--ease-arch) both 0.2s; }
  .a-open__art :global(svg) { width: min(100%, 380px); }
  .a-open__art figcaption { font-size: 0.78rem; color: var(--ink-soft); }
  @keyframes rise { from { opacity: 0; transform: translateY(60px); } }
  @media (max-width: 820px) { .a-open__grid { grid-template-columns: 1fr; } .a-open__art { justify-items: start; } .a-open__art :global(svg) { width: min(60%, 260px); } }

  /* Intro */
  .a-intro__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: 40px clamp(32px, 6vw, 96px); align-items: start; }
  .a-intro h2 { font-size: var(--step-3); position: sticky; top: calc(var(--header-h) + 96px); }
  .a-intro__cols { columns: 2 280px; column-gap: 40px; font-size: var(--step-0); line-height: 1.7; }
  .a-intro__cols p { break-inside: avoid; margin-bottom: 1.2em; }
  .a-intro__cols p:first-child::first-letter { font-family: var(--font-display); float: inline-start; font-size: 4.4em; line-height: 0.8; padding-block-start: 0.06em; padding-inline-end: 0.12em; color: var(--brass-ink); }
  .a-intro__services { grid-column: 2; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .a-intro__services a { display: inline-block; text-decoration: none; font-size: 0.85rem; padding: 6px 12px; border: 1px solid var(--line-light); border-radius: 999px; transition: border-color 0.2s, color 0.2s; }
  .a-intro__services a:hover { border-color: var(--turquoise-ink); color: var(--turquoise-ink); }
  @media (max-width: 820px) { .a-intro__grid { grid-template-columns: 1fr; } .a-intro h2 { position: static; } .a-intro__services { grid-column: 1; } }

  /* Story */
  .a-story { padding-block: var(--section); background: radial-gradient(70% 60% at 25% 50%, var(--lapis-800), var(--lapis-900)); }
  .a-story__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 100px); }
  .a-story__sticky { position: sticky; top: calc(var(--header-h) + 96px); align-self: start; display: grid; gap: 18px; }
  .a-story__sticky h2 { font-size: var(--step-4); }
  .a-story__fig { width: min(100%, 420px); margin-top: 12px; }
  .a-story__dots { list-style: none; display: flex; gap: 10px; }
  .a-story__dots li { width: 9px; height: 9px; border: 1px solid var(--brass); transform: rotate(45deg); transition: background 0.4s; }
  .a-story__dots li.is-on { background: var(--turquoise); border-color: var(--turquoise); }
  .a-story__steps { display: grid; }
  .a-story__step { min-height: 46vh; display: grid; align-content: center; gap: 16px; opacity: 0.45; transition: opacity 0.6s; }
  .a-story__step.is-on { opacity: 1; }
  .a-story__num { font-size: 0.78rem; letter-spacing: 0.2em; color: var(--brass); }
  .a-story__step h3 { font-size: var(--step-4); }
  .a-story__step p.muted { font-size: var(--step-1); line-height: 1.55; max-width: 34ch; }
  .a-story__note { padding-bottom: 2vh; }
  @media (max-width: 820px) {
    .a-story__grid { grid-template-columns: 1fr; }
    .a-story__sticky { position: sticky; top: calc(var(--header-h) + 50px); z-index: 1; background: var(--lapis-900); padding-block: 12px; grid-template-columns: 96px 1fr; align-items: center; column-gap: 18px; }
    .a-story__sticky .eyebrow, .a-story__sticky h2 { grid-column: 2; }
    .a-story__sticky h2 { font-size: var(--step-2); }
    .a-story__fig { grid-row: 1 / span 3; grid-column: 1; margin: 0; }
    .a-story__dots { grid-column: 2; }
    .a-story__step { min-height: 0; padding-block: 40px; opacity: 1; }
  }

  /* Values */
  .a-head { display: grid; gap: 14px; justify-items: start; margin-bottom: clamp(36px, 5vw, 64px); }
  .a-head h2 { font-size: var(--step-4); }
  .a-values__list { list-style: none; display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line-light); }
  .a-value { display: grid; gap: 12px; align-content: start; padding: 28px 22px 32px; border-inline-end: 1px solid var(--line-light); transition: background 0.4s; }
  .a-value:first-child { padding-inline-start: 0; }
  .a-value:last-child { border-inline-end: 0; }
  .a-value svg { width: 30px; height: 30px; fill: none; stroke: var(--brass-ink); stroke-width: 2.4; transition: transform 1s var(--ease-arch), stroke 0.3s; }
  .a-value:hover svg { transform: rotate(45deg); stroke: var(--turquoise-ink); }
  .a-value h3 { font-size: var(--step-2); }
  .a-value p { font-size: 0.95rem; }
  @media (max-width: 1000px) { .a-values__list { grid-template-columns: 1fr 1fr; } .a-value { border-inline-end: 0; border-bottom: 1px solid var(--line-light); padding-inline-start: 0; } }
  @media (max-width: 560px) { .a-values__list { grid-template-columns: 1fr; } }

  /* Team */
  .a-team__grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 44px); }
  .person { display: grid; gap: 8px; align-content: start; }
  .person__art { margin-bottom: 10px; max-width: 320px; }
  .person__name { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .person__name.is-sample { color: var(--garnet); }
  .person h3 { font-size: var(--step-1); }
  .person p.muted { font-size: 0.95rem; max-width: 34ch; }
  @media (max-width: 820px) { .a-team__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .a-team__grid { grid-template-columns: 1fr; } .person__art { max-width: 220px; } }

  /* Heritage */
  .a-heritage__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .a-heritage__art { overflow: hidden; border-radius: 2px; }
  .a-heritage__text { display: grid; gap: 18px; }
  .a-heritage__text h2 { font-size: var(--step-3); }
  .a-heritage__text p { max-width: 50ch; }
  @media (max-width: 820px) { .a-heritage__grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Scroll story: the step in view lights its layer of the figure.
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story) {
    const set = (key: string) => {
      story.querySelectorAll<SVGGElement>('[data-layer]').forEach((g) => g.classList.toggle('is-on', g.dataset.layer === key));
      story.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => s.classList.toggle('is-on', s.dataset.step === key));
      story.querySelectorAll<HTMLElement>('[data-dot]').forEach((d) => d.classList.toggle('is-on', d.dataset.dot === key));
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) set((e.target as HTMLElement).dataset.step!); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    story.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => io.observe(s));
    set('global');
  }
</script>
