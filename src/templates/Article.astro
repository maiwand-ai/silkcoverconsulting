---
import GirihTile from '../components/GirihTile.astro';
import SectionRail from '../components/SectionRail.astro';
import type { Site, Page, Insight } from '../lib/content';

interface Props { site: Site; page: Page; article: Insight; next: Insight }
const { site, page, article: a, next } = Astro.props;
if (page.template.discriminant !== 'insights') throw new Error('Articles live under the insights page');
const L = page.template.value.labels;
const S = site.settings;
const svc = a.service ? site.serviceBySlug[a.service] : undefined;
const slugify = (t: string, i: number) => `h-${i + 1}-${t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 40)}`.replace(/-$/, '');
const headings = a.body.map((b, i) => ({ ...b, id: b.type === 'h2' ? slugify(b.text, i) : undefined }));
const railItems = [{ id: 'introduction', label: L.introduction }, ...headings.filter((b) => b.id).map((b) => ({ id: b.id!, label: b.text })), ...(next.slug !== a.slug ? [{ id: 'next', label: L.next }] : [])];
---
<article class="post">
  <header class="post__head" data-tone="ivory">
    <div class="container post__head-grid">
      <div class="post__head-text">
        <p class="post__crumbs"><a href={site.templatePath('insights')}>{page.menu.label || page.title}</a> <span aria-hidden="true">/</span> {a.kind}</p>
        <h1>{a.title}</h1>
        <p class="post__dek muted">{a.dek}</p>
        <p class="post__meta">{site.readMinutes(a).toLocaleString(site.info.lang)} {L.minRead} {a.sample && <span class="sample-tag">{S.tags.sample}</span>}</p>
      </div>
      <div class="post__art"><GirihTile id="post-art" fold={a.fold} tone="dark" tile={100} h={460} /></div>
    </div>
  </header>

  <SectionRail items={railItems} title={S.common.onThisPage} />

  <div class="post__body" id="introduction" data-tone="light" data-article-body>
    <div class="container post__layout">
      <div class="post__text">
        {headings.map((b) =>
          b.type === 'h2' ? <h2 id={b.id}>{b.text}</h2> :
          b.type === 'quote' ? <blockquote><p>{b.text}</p></blockquote> :
          <p>{b.text}</p>
        )}
      </div>
      {svc && (
        <aside class="post__aside">
          <div class="post__card">
            <p class="post__card-k">{L.related}</p>
            <a href={`${site.templatePath('expertise')}#${svc.slug}`} class="post__card-t">{svc.title}</a>
            <p class="muted">{svc.line}</p>
            <button class="btn btn--solid" type="button" data-enquire data-service={svc.slug}>{L.discuss}</button>
          </div>
        </aside>
      )}
    </div>
  </div>
</article>

{next.slug !== a.slug && (
<nav class="post__next" id="next" data-tone="dark" aria-label={L.next}>
  <a class="container post__next-link" href={site.articlePath(next.slug)}>
    <span class="post__next-k">{L.next}</span>
    <span class="post__next-t">{next.title}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
  </a>
</nav>
)}
<style>

  .post__head { padding-top: calc(var(--header-h) + clamp(36px, 6vw, 80px)); padding-bottom: clamp(40px, 6vw, 80px); }
  .post__head-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.6fr); gap: clamp(28px, 5vw, 80px); align-items: end; }
  .post__head-text { display: grid; gap: 20px; }
  .post__crumbs { font-size: 0.78rem; font-weight: 600; letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--brass-ink); }
  .post__crumbs a { color: var(--turquoise-ink); text-decoration: none; }
  .post__crumbs span { margin-inline: 6px; opacity: 0.5; }
  .post h1 { font-size: var(--step-4); line-height: 1.05; max-width: 20ch; }
  .post__dek { font-size: var(--step-1); max-width: 44ch; }
  .post__meta { display: flex; gap: 14px; align-items: center; font-size: 0.85rem; color: var(--ink-soft); }
  .post__art { max-width: 280px; justify-self: end; width: 100%; }
  @media (max-width: 820px) { .post__head-grid { grid-template-columns: 1fr; } .post__art { justify-self: start; max-width: 180px; } }

  .post__body { padding-block: clamp(48px, 7vw, 100px); }
  .post__layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .post__text { max-width: 66ch; font-size: 1.12rem; line-height: 1.75; }
  .post__text > p { margin-bottom: 1.3em; }
  .post__text > p:first-child::first-letter { font-family: var(--font-display); float: inline-start; font-size: 4.6em; line-height: 0.8; padding-block-start: 0.08em; padding-inline-end: 0.12em; color: var(--turquoise-ink); }
  .post__text h2 { font-size: var(--step-2); margin: 1.6em 0 0.6em; }
  .post__text blockquote { margin: 1.6em 0; padding-block: 0.4em; padding-inline: 1.4em 0; border-inline-start: 2px solid var(--brass); }
  .post__text blockquote p { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; color: var(--ink); }
  .post__aside { position: sticky; top: calc(var(--header-h) + 96px); }
  .post__card { display: grid; gap: 12px; padding: 26px; background: var(--ivory); border-radius: 120px 120px 2px 2px / 50px 50px 2px 2px; padding-top: 46px; }
  .post__card-k { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brass-ink); }
  .post__card-t { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; text-decoration: none; }
  .post__card-t:hover { color: var(--turquoise-ink); }
  .post__card .btn { justify-self: start; margin-top: 6px; }
  @media (max-width: 900px) { .post__layout { grid-template-columns: 1fr; } .post__aside { position: static; } }

  .post__next { padding-block: clamp(40px, 6vw, 72px); }
  .post__next-link { display: grid; grid-template-columns: 1fr auto; gap: 8px 24px; align-items: center; text-decoration: none; }
  .post__next-k { font-size: 0.75rem; font-weight: 600; letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--brass); }
  .post__next-t { grid-row: 2; font-family: var(--font-display); font-size: var(--step-3); line-height: 1.1; transition: color 0.3s; }
  .post__next-link svg { grid-row: 1 / span 2; grid-column: 2; width: 40px; height: 40px; fill: none; stroke: currentColor; stroke-width: 1.2; transition: transform 0.4s var(--ease-out); }
  .post__next-link:hover .post__next-t { color: var(--turquoise); }
  .post__next-link:hover svg { transform: translateX(8px); }
</style>
